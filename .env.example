# Docker Compose reads this file after copying it to .env.
# Native Go execution reads exported environment variables, not .env files.
APP_PORT=8080
APP_LOG_LEVEL=info
APP_PUBLIC_URL=http://127.0.0.1:8080
APP_TRUSTED_PROXIES=
# Required only when creating a fresh installation. Set a temporary strong value,
# then remove it after first-run setup. Never commit real credentials here.
APP_BOOTSTRAP_USERNAME=
APP_BOOTSTRAP_PASSWORD=
